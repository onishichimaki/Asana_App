{
  "ConnectionStrings": {
    "TaskCapture": ""
  },
  "Database": {
    "Provider": "SqlServer",
    "ApplyMigrations": true
  },
  "TaskOrganization": {
    "Mode": "AzureOpenAI",
    "FallbackToRuleBased": true,
    "AzureOpenAI": {
      "Endpoint": "https://YOUR-RESOURCE.openai.azure.com",
      "ApiKey": "",
      "DeploymentName": "YOUR-DEPLOYMENT",
      "TimeoutSeconds": 20
    }
  },
  "Integration": {
    "Asana": {
      "Mode": "Api",
      "CredentialMode": "PerUserOAuth",
      "DefaultWorkspaceGid": "",
      "DefaultProjectGid": "",
      "OAuth": {
        "ClientId": "",
        "ClientSecret": "",
        "RedirectUri": "https://YOUR-HOST/api/asana/connection/callback",
        "RequireMatchingEmail": true
      }
    }
  },
  "Access": {
    "Mode": "EmailCode",
    "AdminEmails": [],
    "AllowedEmailDomains": [
      "example.co.jp"
    ],
    "EmailCode": {
      "CodeLifetimeMinutes": 10,
      "SessionDays": 14,
      "MaximumAttempts": 5,
      "Delivery": {
        "Mode": "Smtp",
        "Host": "smtp.example.co.jp",
        "Port": 587,
        "EnableSsl": true,
        "Username": "",
        "Password": "",
        "FromAddress": "taskcapture@example.co.jp",
        "FromName": "Task Capture"
      }
    }
  },
  "DataProtection": {
    "KeysPath": "C:\\ProgramData\\TaskCapture\\keys"
  },
  "AllowedHosts": "YOUR-HOST"
}
