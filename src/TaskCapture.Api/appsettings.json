{
  "ConnectionStrings": {
    "TaskCapture": "Server=(localdb)\\MSSQLLocalDB;Database=TaskCapture;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Database": {
    "Provider": "SqlServer",
    "InMemoryDatabaseName": "TaskCaptureDevelopment",
    "ApplyMigrations": true
  },
  "TaskOrganization": {
    "Mode": "RuleBased",
    "FallbackToRuleBased": true,
    "Gemini": {
      "Model": "gemini-3.5-flash",
      "TimeoutSeconds": 20
    },
    "AzureOpenAI": {
      "Endpoint": "",
      "ApiKey": "",
      "DeploymentName": "",
      "TimeoutSeconds": 20
    }
  },
  "Integration": {
    "Asana": {
      "Mode": "Mock",
      "CredentialMode": "PersonalAccessToken",
      "PersonalAccessToken": "",
      "DefaultWorkspaceGid": "",
      "DefaultProjectGid": "",
      "OAuth": {
        "ClientId": "",
        "ClientSecret": "",
        "RedirectUri": "",
        "RequireMatchingEmail": true,
        "Scopes": [
          "projects:read",
          "sections:read",
          "tasks:read",
          "tasks:write",
          "tasks:delete",
          "users:read",
          "workspaces:read"
        ]
      }
    }
  },
  "Access": {
    "Mode": "Development",
    "LocalEmail": "local-user@taskcapture.local",
    "LocalDisplayName": "ローカル利用者",
    "AdminEmails": [],
    "AllowedEmailDomains": [],
    "EmailCode": {
      "CodeLifetimeMinutes": 10,
      "SessionDays": 14,
      "MaximumAttempts": 5,
      "Delivery": {
        "Mode": "Mock",
        "Host": "",
        "Port": 587,
        "EnableSsl": true,
        "Username": "",
        "Password": "",
        "FromAddress": "",
        "FromName": "Task Capture"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
